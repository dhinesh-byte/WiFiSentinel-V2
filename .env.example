# AI is optional. Leave AI_PROVIDER blank to keep the assistant disabled.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=

# For openai_compatible providers, set the endpoint root (for example, a local
# OpenAI-compatible server URL ending in /v1). This endpoint receives only the
# current question, bounded conversation context, and selected report evidence.
AI_BASE_URL=
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=900

# Optional shared login. Leave these blank for loopback-only unauthenticated use.
# Both account types have the same app permissions; usernames must be distinct.
VULNSCAN_ADMIN_USERNAME=
VULNSCAN_ADMIN_PASSWORD=
VULNSCAN_USER_USERNAME=
VULNSCAN_USER_PASSWORD=
WIFI_SENTINEL_SECRET_KEY=